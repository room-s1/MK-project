# Базовый стиль
BasedOnStyle: Google

# ============================================
# ОТСТУПЫ (2 пробела для STM32)
# ============================================
IndentWidth: 2
TabWidth: 2
UseTab: Never
ContinuationIndentWidth: 2

# ============================================
# КОММЕНТАРИИ — КРАСИВОЕ ОФОРМЛЕНИЕ
# ============================================

# Выравнивание комментариев справа (ровная колонка)
AlignTrailingComments: true

# Количество пробелов перед комментарием
SpacesBeforeTrailingComments: 2

# Перенос длинных комментариев
ReflowComments: true

# Максимальная длина строки (комментарии длиннее будут перенесены)
ColumnLimit: 120

# ============================================
# СКОБКИ (стиль Allman для функций)
# ============================================
BreakBeforeBraces: Allman
AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: Never

# ============================================
# УКАЗАТЕЛИ (int* ptr, а не int *ptr)
# ============================================
PointerAlignment: Left

# ============================================
# ПРОБЕЛЫ ВОКРУГ ОПЕРАТОРОВ
# ============================================
SpaceBeforeParens: ControlStatements
SpaceAfterLogicalNot: false

# ============================================
# СОРТИРОВКА INCLUDE (отключаем, порядок важен)
# ============================================
SortIncludes: false